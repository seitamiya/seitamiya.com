---
import '@fontsource-variable/newsreader/wght.css';
import fontUrl from '@fontsource-variable/newsreader/files/newsreader-latin-wght-normal.woff2?url';
import { SITE } from '../site';
const { title, description = SITE.description } = Astro.props;
const pageTitle = title ? `${title} — ${SITE.title}` : SITE.title;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f6f1e7" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:site" content="@seitamiya" />
    <style is:global>
      :root { --bg: #f6f1e7; --fg: #2a2620; --link: #1e50a2; }
      body {
        max-width: 640px;
        margin: 0 auto;
        padding: 40px 20px 80px;
        font-family: "Newsreader Variable", Georgia, serif;
        font-size: 16px;
        line-height: 1.6;
        color: var(--fg);
        background: var(--bg);
        -webkit-font-smoothing: antialiased;
      }
      a { color: var(--link); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px; }
      .muted, time { opacity: 0.55; }
      header { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 64px; }
      header .name { color: var(--fg); font-weight: 600; text-decoration: none; font-size: 19px; }
      header nav a { color: var(--fg); opacity: 0.55; text-decoration: none; }
      header nav a:hover { opacity: 1; }
      h1, h2, h3 { font-size: 1em; font-weight: 600; margin: 2em 0 0.6em; }
      h1, .title { font-size: 19px; margin: 0; }
      img { max-width: 100%; }
      pre { overflow-x: auto; padding: 12px; font-size: 14px; }
      blockquote { margin: 0; padding-left: 1em; border-left: 2px solid currentColor; opacity: 0.8; }
      ul.posts { list-style: none; padding: 0; margin: 0; }
      ul.posts li { display: flex; gap: 1.2em; margin-bottom: 0.3em; }
      ul.posts time { font-variant-numeric: tabular-nums; flex-shrink: 0; min-width: 7em; }
      footer { margin-top: 72px; }
      footer a { color: var(--fg); opacity: 0.55; text-decoration: none; margin-right: 1em; }
      footer a:hover { opacity: 1; }
    </style>
  </head>
  <body>
    <header>
      <a class="name" href="/">{SITE.title}</a>
      <nav><a href="/about/">About</a></nav>
    </header>
    <slot />
    <footer>
      <a href={SITE.x} target="_blank" rel="noopener noreferrer">X</a>
      <a href={SITE.github} target="_blank" rel="noopener noreferrer">GitHub</a>
    </footer>
  </body>
</html>
