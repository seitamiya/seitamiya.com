---
import '@fontsource-variable/newsreader/wght.css';
import fontUrl from '@fontsource-variable/newsreader/files/newsreader-latin-wght-normal.woff2?url';

const { title } = Astro.props as { title?: string };
const pageTitle = title ? `${title} — Seita Miyamoto` : 'Seita Miyamoto';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta property="og:title" content={pageTitle} />
    <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <style is:global>
      body {
        max-width: 640px;
        margin: 0 auto;
        padding: 40px 20px 80px;
        font: 16px/1.6 "Newsreader Variable", Georgia, serif;
        color: #2a2620;
        background: #f6f1e7;
      }
      a { color: #1e50a2; text-decoration-thickness: 1px; text-underline-offset: 3px; }
      header { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 64px; }
      header a, footer a { color: inherit; text-decoration: none; }
      nav a, footer a, time { opacity: 0.55; }
      nav a:hover, footer a:hover { opacity: 1; }
      .name, h1 { font-size: 19px; font-weight: 600; margin: 0; }
      h2, h3 { font-size: 1em; margin: 2em 0 0.6em; }
      img { max-width: 100%; }
      pre { overflow-x: auto; font-size: 14px; }
      .posts { list-style: none; padding: 0; margin: 0.6em 0 0; }
      .posts li { display: flex; gap: 1.2em; margin-bottom: 0.3em; }
      .posts time { min-width: 5em; flex-shrink: 0; }
      footer { margin-top: 72px; display: flex; gap: 1em; }
    </style>
  </head>
  <body>
    <header>
      <a class="name" href="/">Seita Miyamoto</a>
      <nav><a href="/about/">About</a></nav>
    </header>
    <slot />
    <footer>
      <a href="https://x.com/seitamiya" target="_blank">X</a>
      <a href="https://github.com/seitamiya" target="_blank">GitHub</a>
    </footer>
  </body>
</html>
